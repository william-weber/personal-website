---
layout: layouts/base.njk
title: Projects
permalink: /projects/
---

<section class="space-y-8">
  <header class="space-y-3">
    <h1 class="text-3xl font-semibold tracking-tight text-ink-100">{{ projects.headline }}</h1>
    <p class="text-[var(--color-muted)]">{{ projects.blurb }}</p>
  </header>

  <ul class="space-y-6">
    {% for item in projects.items %}
      <li class="border border-ink-800/60 rounded-lg p-5 space-y-2">
        <div class="flex items-baseline justify-between gap-4 flex-wrap">
          <h2 class="text-xl font-medium text-ink-200">{{ item.title }}</h2>
          <span class="text-xs uppercase tracking-wider text-[var(--color-muted)]">{{ item.status }}</span>
        </div>
        <p class="text-sm">{{ item.blurb }}</p>
      </li>
    {% endfor %}
  </ul>
</section>
