---
layout: layouts/base.njk
title: Home
---

<section class="space-y-6">
  <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-ink-100">
    {{ site.title }}
  </h1>
  <p class="text-lg text-[var(--color-muted)]">
    {{ site.tagline }}
  </p>
  <div class="pt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    {% for item in site.nav %}
      <a href="{{ item.href }}" class="text-ink-300 hover:text-ink-200">{{ item.label }} →</a>
    {% endfor %}
  </div>
</section>
