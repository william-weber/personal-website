---
layout: layouts/base.njk
title: Algorithmic Visuals
permalink: /experiments/code-art/
---

{% set section = experiments.sections[1] %}

{% import "partials/section-marker.njk" as marker %}

<div class="pt-20 pb-16 max-w-[860px]">
  {{ marker.sectionMarker("02 / 02", section.title) }}

  <div class="mb-3 font-mono text-[11px] tracking-[0.08em] uppercase">
    <a href="/experiments/" style="color: var(--color-faint);" class="hover:[color:var(--color-fg)]">← experiments</a>
  </div>

  <h1
    class="font-sans m-0 mb-4"
    style="font-weight: 100; font-size: clamp(48px, 7vw, 80px); line-height: 0.95; letter-spacing: -0.03em; color: var(--color-fg-strong);"
  >
    {{ section.title }}<span style="color: var(--color-accent);">.</span>
  </h1>
  <p class="font-mono text-[12.5px] tracking-[0.02em] m-0 mb-14" style="color: var(--color-muted);">{{ section.blurb }}</p>

  {% if section.items and section.items.length %}
    <div class="flex flex-col border-t" style="border-color: var(--color-hairline-strong);">
      {% for item in section.items %}
        {% set isExternal = item.href and ("://" in item.href) %}
        {% if item.href %}
          <a
            href="{{ item.href }}"
            {% if isExternal %}target="_blank" rel="noopener"{% endif %}
            class="ww-row grid items-center gap-6 py-7 border-b"
            style="grid-template-columns: 60px 1fr 24px; border-color: var(--color-hairline-strong);"
          >
            <span class="font-mono text-[11px] tracking-[0.12em]" style="color: var(--color-accent);">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
            <div>
              <div class="font-sans text-[20px] mb-1.5" style="font-weight: 200; color: var(--color-fg-strong);">{{ item.title }}</div>
              {% if item.note %}<div class="text-[13px]" style="color: var(--color-muted);">{{ item.note }}</div>{% endif %}
            </div>
            <span class="ww-card-arrow font-mono opacity-50" style="color: var(--color-accent);">{% if isExternal %}↗{% else %}→{% endif %}</span>
          </a>
        {% else %}
          <div
            class="ww-row grid items-center gap-6 py-7 border-b"
            style="grid-template-columns: 60px 1fr 24px; border-color: var(--color-hairline-strong);"
          >
            <span class="font-mono text-[11px] tracking-[0.12em]" style="color: var(--color-accent);">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
            <div>
              <div class="font-sans text-[20px] mb-1.5" style="font-weight: 200; color: var(--color-fg-strong);">{{ item.title }}</div>
              {% if item.note %}<div class="text-[13px]" style="color: var(--color-muted);">{{ item.note }}</div>{% endif %}
            </div>
            <span></span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <div
      class="py-10 px-7 border font-mono text-[11px] tracking-[0.10em] uppercase flex items-center gap-3"
      style="border-color: var(--color-hairline-strong); color: var(--color-faint);"
    >
      <span class="inline-block w-[5px] h-[5px] rounded-full pulse-soft" style="background: var(--color-status-progress);"></span>
      <span>standby — nothing in this channel yet</span>
    </div>
  {% endif %}
</div>
