<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description or site.tagline }}" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg)] text-[var(--color-fg)] font-sans antialiased">
    {% include "partials/header.njk" %}
    <main class="flex-1 mx-auto w-full max-w-3xl px-6 py-12">
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
  </body>
</html>
