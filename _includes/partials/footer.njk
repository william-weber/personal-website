<footer class="border-t border-ink-800/60 mt-16">
  <div class="mx-auto w-full max-w-3xl px-6 py-6 flex flex-wrap items-center justify-between gap-3 text-sm text-[var(--color-muted)]">
    <span>© {{ site.footer.year }} {{ site.title }}</span>
    <ul class="flex gap-4">
      {% for link in site.footer.links %}
        <li><a href="{{ link.href }}" class="hover:text-ink-200">{{ link.label }}</a></li>
      {% endfor %}
    </ul>
  </div>
</footer>
